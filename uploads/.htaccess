# Let's Explore DMC — Safe Uploads Configuration
# LiteSpeed & Apache 2.4 Compatible

# Prevent execution of backend server-side scripts
<FilesMatch "(?i)\.(php|php[0-9]?|phtml|pl|py|cgi|sh|bash)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order Deny,Allow
        Deny from all
    </IfModule>
</FilesMatch>

# Allow public viewing and downloading of travel documents, PDFs, HTML proposals & media
<FilesMatch "(?i)\.(pdf|docx|doc|html|htm|png|jpg|jpeg|webp|svg|css|js)$">
    <IfModule mod_authz_core.c>
        Require all granted
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order Allow,Deny
        Allow from all
    </IfModule>
</FilesMatch>

<IfModule mod_mime.c>
    AddType application/pdf .pdf
    AddType text/html .html .htm
</IfModule>

<IfModule mod_headers.c>
    Header set Access-Control-Allow-Origin "*"
</IfModule>
