# Protect uploaded PDFs: Disable directory listing and script execution
Options -Indexes -ExecCGI

# Prevent execution of any scripts in the uploads directory
<FilesMatch "\.(php|php[0-9]|phtml|pl|py|cgi|sh|bash|html|htm|js)$">
    Order Deny,Allow
    Deny from all
</FilesMatch>

# Force correct MIME type for PDFs
<FilesMatch "\.pdf$">
    ForceType application/pdf
</FilesMatch>

# Security hardening headers
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set Content-Security-Policy "default-src 'none'; style-src 'unsafe-inline'; sandbox"
</IfModule>
