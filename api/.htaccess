# Protect sensitive configuration files from direct web browser access
<FilesMatch "^(config\.php|config\.sample\.php|\.env.*)$">
    Order Deny,Allow
    Deny from all
</FilesMatch>

Options -Indexes

# LiteSpeed: Allow sufficient execution time for AI reasoning pipelines without premature abort
<IfModule Litespeed>
    RewriteEngine On
    RewriteRule .* - [E=noconntimeout:1,E=noabort:1]
</IfModule>
